# Postgres, used by docker-compose.yml when you run `docker compose up -d` from the repo root.
# apps/api and apps/web each have their own .env.example with the variables they read at runtime
# (apps/api/.env.example, apps/web/.env.example) — copy this one alongside those, not instead of them.
POSTGRES_USER=quizora
POSTGRES_PASSWORD=quizora
POSTGRES_DB=quizora
POSTGRES_PORT=5432
