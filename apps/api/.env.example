DATABASE_URL="postgresql://quizora:quizora@localhost:5432/quizora"
# Any value works locally. In production the API refuses this one and anything shorter
# than 32 characters: generate a secret, e.g. `openssl rand -base64 48`.
JWT_SECRET="change-me-in-production"
API_PORT=3001
# e2e tests (npm run test:e2e) wipe and refill this database. Its name must end in _test.
TEST_DATABASE_URL="postgresql://quizora:quizora@localhost:5432/quizora_test"
