# Dependencies
node_modules/

# Build output
.next/
dist/
out/
build/

# Env files: every variant (.env.local, .env.production, .env.test, ...); only the
# .env.example files are committed
.env
.env.*
!.env.example

# Logs
npm-debug.log*
*.log

# Testing / coverage
coverage/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Claude Code runtime state and personal settings
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Prisma
apps/api/prisma/migrations/dev.db

# TypeScript build info
*.tsbuildinfo

# Auto-generated by `next dev`/`next build`, regenerated on demand
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Python bytecode (created when skill scripts run)
__pycache__/
*.pyc
